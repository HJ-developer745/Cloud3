# COPY THESE VALUES INTO RENDER -> Environment.
# Do NOT upload a real .env file with passwords to GitHub.

PORT=10000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/clouddrive?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ORIGIN=*
MAX_FILE_SIZE=524288000
STORAGE_QUOTA=16106127360
TRASH_RETENTION_DAYS=30

# Optional seed/admin values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=Demo123!
